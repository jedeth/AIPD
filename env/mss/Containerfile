# Image MonServiceSécurisé (ANSSI) pour une instance locale de développement.
# Contexte de build : ../../mon-service-securise (branche local/connexion-dev).
FROM docker.io/library/node:24.22.2-bookworm

ENV HUSKY=0 \
    CI=true \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    pnpm_config_store_dir=/pnpm-store

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN npm install -g "pnpm@$(node -p 'require("./package.json").packageManager.split("@")[1]')" \
 && pnpm install --frozen-lockfile

COPY . .
RUN rm -rf .git .env && pnpm run build:back && pnpm run build:front

EXPOSE 3000
# Migrations au démarrage, comme le service officiel
CMD ["sh", "-c", "pnpm run migration-bdd && exec node dist/server.js"]
