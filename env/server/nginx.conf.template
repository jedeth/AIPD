server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 50m;

    # Résolution DNS dynamique : un redémarrage de pia-back (nouvelle IP) ne casse pas le proxy
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $back http://back:3000;

    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Front Angular (routage par hash : tout est servi depuis index.html)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API pia-back : /api/pias -> http://back:3000/pias
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $back;
        # Les appels à l'assistant IA peuvent prendre du temps
        proxy_read_timeout 120s;
    }

    # Pièces jointes (URLs ActiveStorage générées par Rails)
    location /rails/ {
        proxy_pass $back;
    }
}
